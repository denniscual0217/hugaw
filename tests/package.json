{
  "name": "hugaw-comparison",
  "private": true,
  "type": "module",
  "description": "Runs ESLint and hugaw over the same file so their findings can be compared.",
  "scripts": {
    "eslint": "eslint src --no-warn-ignored",
    "hugaw": "node ../dist/bin.js \"tests/src/**/*.tsx\" --config ./hugaw.config.ts",
    "compare": "node compare.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.1"
  }
}
